{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "aab-e-sindh": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "aes",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/aab-e-sindh",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.svg"],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "node_modules/leaflet/dist/leaflet.css",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" },
                { "type": "anyComponentStyle", "maximumWarning": "10kB", "maximumError": "12kB" }
              ],
              "allowedCommonJsDependencies": ["leaflet"],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "aab-e-sindh:build:production" },
            "development": { "buildTarget": "aab-e-sindh:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
